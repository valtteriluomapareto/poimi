# fastlane Fastfile — CI → TestFlight deploy pipeline (issue #135).
#
# Lanes:
#   • build_only — archive + sign a Release .ipa, NO upload. The bring-up step-2
#                  isolator: proves runner + Xcode pin + signing + secret loading
#                  without touching App Store Connect. Runnable independently.
#   • beta       — build_only's archive → upload to TestFlight (internal) → poll
#                  App Store Connect until the build's processingState is VALID
#                  (bounded timeout; fails the run on INVALID / timeout).
#   • upload_screenshots — push the framed App Store marketing screenshots (the
#                  Scripts/framing output, committed under screenshots/appstore/framed/)
#                  to App Store Connect. Screenshots ONLY — no binary, no metadata, no
#                  submission. Run via the manual `upload-screenshots.yml` workflow (the
#                  framed set is committed, so CI needs no sim/photos) or locally with the
#                  ASC key env. Independent of the build lanes.
#
# Signing (see the issue's "Signing" section): Apple offers no server-side
# distribution signing, so a real Apple Distribution cert + App Store profile must
# be on the runner. We use `match(appstore)` in READONLY mode — cert + key + profile
# live encrypted in a private git repo and are imported into a TEMPORARY keychain
# created by `setup_ci`. The ASC API key is AUTH ONLY (upload + profile refresh); it
# is NOT a signing substitute. IMPORTANT: match imports the identity but does NOT
# change the project's signing style — the project is CODE_SIGN_STYLE=Automatic with
# no profile specifier, so this lane FORCES manual signing before archiving (via
# update_code_signing_settings + gym xcargs + export_options); otherwise gym would
# try to auto-sign on a runner with no signed-in account and fail.
#
# Required environment (provided by the `testflight` GitHub Environment secrets —
# NEVER hard-coded, NEVER echoed; see .github/workflows/testflight.yml):
#   ASC_KEY_ID                — App Store Connect API key id
#   ASC_ISSUER_ID             — App Store Connect API issuer id
#   ASC_KEY_CONTENT_BASE64    — base64 of the .p8 private key (key_content, no temp file)
#   MATCH_GIT_URL             — the private certs/profiles repo (match storage)
#   MATCH_PASSWORD            — passphrase decrypting the match repo
#   MATCH_GIT_BASIC_AUTHORIZATION — base64 "user:token" for read access to MATCH_GIT_URL
#   GITHUB_RUN_NUMBER         — injected by Actions; becomes CURRENT_PROJECT_VERSION
#
# Secret hygiene: no `set -x`, no `--verbose`. The temp keychain from setup_ci is
# torn down automatically at the end of the CI job.

default_platform(:ios)

# --- Shared configuration ----------------------------------------------------

APP_IDENTIFIER = "com.valtteriluoma.poimi".freeze
TEAM_ID        = "N4FKQHR5AC".freeze                    # DEVELOPMENT_TEAM in project.pbxproj
XCODEPROJ      = "App/PoimiApp.xcodeproj".freeze
SCHEME         = "PoimiApp".freeze
OUTPUT_DIR     = "build".freeze
OUTPUT_NAME    = "PoimiApp".freeze
# The App Store provisioning profile match creates/stores for this app.
PROFILE_NAME   = "match AppStore #{APP_IDENTIFIER}".freeze

# How long to wait for App Store Connect to finish processing the upload before
# failing the run (issue AC: fail unless processingState == VALID within a bound).
PROCESSING_TIMEOUT_SECONDS = 1800 # 30 minutes
PROCESSING_POLL_SECONDS    = 30

# Build the App Store Connect API key hash once (key_content, base64 — no temp file
# on disk). Reused by match, upload, and the processing poll.
def asc_api_key
  @asc_api_key ||= app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

# The build number for this run: GITHUB_RUN_NUMBER is monotonic + unique per upload,
# so no agvtool (the plist is synthesized) and no ASC round-trip. Local runs (no
# Actions env) fall back to a timestamp so build_only still works off-CI.
def build_number
  ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
end

# The canonical marketing version = MARKETING_VERSION in project.pbxproj (single source
# of truth; feeds CFBundleShortVersionString + the About screen). The release lane only
# READS it — it is bumped deliberately by a human via Scripts/bump-version.sh, never here.
# Scripts/check-version.sh guarantees every occurrence is an identical semver, so the
# first match is authoritative.
def marketing_version
  @marketing_version ||= begin
    line = File.readlines(pbxproj_path).find { |l| l =~ /MARKETING_VERSION = / }
    UI.user_error!("No MARKETING_VERSION in #{pbxproj_path}") if line.nil?
    line[/MARKETING_VERSION = ([^;]+);/, 1].strip
  end
end

# The project.pbxproj, resolved defensively. fastlane evaluates the Fastfile with CWD = fastlane/ and
# build_app/gym changes the CWD again mid-run, so a single relative/CWD-based path is fragile (it bit us
# twice with ENOENT). Try the known locations — anchored to fastlane's own folder, then repo-root CWD,
# then fastlane/ CWD — and use the first that exists.
def pbxproj_path
  @pbxproj_path ||= begin
    candidates = [
      File.join(FastlaneCore::FastlaneFolder.path.to_s, "..", XCODEPROJ, "project.pbxproj"),
      File.join(XCODEPROJ, "project.pbxproj"),
      File.join("..", XCODEPROJ, "project.pbxproj")
    ].map { |path| File.expand_path(path) }
    candidates.find { |path| File.exist?(path) } ||
      UI.user_error!("project.pbxproj not found; tried: #{candidates.join(', ')}")
  end
end

# The framed App Store screenshots produced by Scripts/framing (frame-all.mjs): one folder per ASC
# locale (en-US, fi), each holding NN_<device>_<screen>.png. Anchored to the Fastfile's own folder
# (fastlane runs with CWD = fastlane/ — the same fragility pbxproj_path guards against). Raises with a
# generate-me hint if the set is missing, so the upload can never quietly push zero screenshots.
def framed_screenshots_path
  @framed_screenshots_path ||= begin
    path = File.expand_path(
      File.join(FastlaneCore::FastlaneFolder.path.to_s, "..", "screenshots", "appstore", "framed")
    )
    unless Dir.exist?(path) && Dir.glob(File.join(path, "*", "*.png")).any?
      UI.user_error!("No framed screenshots at #{path} — run Scripts/appstore-screenshots.sh, then " \
                     "`node Scripts/framing/frame-all.mjs`, before this lane.")
    end
    path
  end
end

# The App Store marketing sizes for the slots we ship (portrait): iPhone 6.9" + iPad 13". deliver infers
# the device slot from the image dimensions and SILENTLY drops any image whose size it doesn't recognize
# (calculate_display_type returns nil, no error) — so upload_screenshots pre-checks against this list and
# fails loudly, rather than shipping a half-empty set if the bespoke compositor ever drifts a few pixels.
ACCEPTED_SCREENSHOT_SIZES = [[1320, 2868], [2064, 2752]].freeze

# Screenshot de-dup convergence: how many settle-and-retry passes, and how long to wait between them for
# ASC to register deletes/uploads (the dedup runs inside the same ~10-17s processing window as the bug).
DEDUP_MAX_ATTEMPTS = 4
DEDUP_SETTLE_SECONDS = 15

# App Store text-metadata char limits, by filename (for upload_metadata's local pre-flight — deliver
# also errors on over-limit, but we fail faster + friendlier). Fields without a limit (the *_url.txt) are
# only checked for non-emptiness. Keep in sync with fastlane/metadata/README.md.
METADATA_CHAR_LIMITS = { "subtitle" => 30, "keywords" => 100, "description" => 4000, "promotional_text" => 170 }.freeze

# A PNG's [width, height] read straight from its IHDR chunk (big-endian u32 at bytes 16..24) — no image
# gem needed. Returns nil for anything that isn't a PNG.
def png_dimensions(file)
  header = File.binread(file, 24)
  return nil unless header && header.bytesize == 24 && header[0, 8] == "\x89PNG\r\n\x1a\n".b
  header[16, 8].unpack("N2")
end

# The repo's App Store text-metadata folder (deliver's fastlane/metadata layout). Anchored to the
# Fastfile's own folder — fastlane runs with CWD = fastlane/, so a bare relative path is fragile (same
# reason pbxproj_path/framed_screenshots_path resolve absolutely).
def metadata_dir
  @metadata_dir ||= File.join(FastlaneCore::FastlaneFolder.path.to_s, "metadata")
end

# Fail fast (with a hint) if the App Store Connect API key env is missing — shared by the upload lane
# and the standalone dedup lane, both of which get run by hand.
def check_asc_env!
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT_BASE64].reject { |v| ENV[v].to_s.strip != "" }
  return if missing.empty?
  UI.user_error!("Missing App Store Connect API key env: #{missing.join(', ')} — export them (see " \
                 "docs/deploy/testflight-setup.md §5.5) or run the upload-screenshots CI workflow.")
end

# Point spaceship's ConnectAPI at the ASC API key (for the direct model calls the screenshot dedup makes).
def configure_spaceship_token
  require "spaceship"
  require "base64"
  check_asc_env!
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key: Base64.decode64(ENV.fetch("ASC_KEY_CONTENT_BASE64"))
  )
end

# How many screenshots each ASC locale should end up with, from the committed framed set — the source of
# truth the dedup verifies against. Counted from the local files (not ASC's file_name), so it catches a
# silent no-op (e.g. a spaceship bump that nils file_name) as well as visible duplicates.
def expected_screenshots_by_locale
  Dir.glob(File.join(framed_screenshots_path, "*", "*.png")).each_with_object(Hash.new(0)) do |f, counts|
    counts[File.basename(File.dirname(f))] += 1
  end
end

# Screenshots currently on the editable version, per locale (summed across its display-type sets).
def asc_screenshots_by_locale(version)
  version.get_app_store_version_localizations.each_with_object(Hash.new(0)) do |loc, counts|
    loc.get_app_screenshot_sets.each { |set| counts[loc.locale] += set.app_screenshots.size }
  end
end

# One dedup pass over the editable version: within each localization × screenshot set, keep the
# LOWEST-position screenshot per file name and delete the rest. Deletes ONLY same-named duplicates (never
# a blank name), so it can never remove a wanted screenshot; keeping the lowest position preserves the
# NN_ display order. Logs each deletion; a transient delete failure is logged, not raised (the caller
# re-checks counts and retries). Returns how many it deleted.
def dedup_pass(version)
  removed = 0
  version.get_app_store_version_localizations.each do |loc|
    loc.get_app_screenshot_sets.each do |set|
      slot = set.respond_to?(:screenshot_display_type) ? set.screenshot_display_type : "?"
      set.app_screenshots.group_by(&:file_name).each do |name, group|
        next if name.nil? || name.to_s.empty? || group.size <= 1 # only delete identifiable duplicates
        keep, *dups = group.sort_by { |s| s.respond_to?(:position) ? s.position.to_i : 0 }
        dups.each do |dup|
          UI.message("De-dup: #{loc.locale} #{slot} — deleting duplicate '#{name}' (keeping id #{keep.id}).")
          begin
            dup.delete!
            removed += 1
          rescue StandardError => e
            UI.important("De-dup: delete failed for '#{name}' (#{loc.locale}): #{e.message} — will re-check + retry.")
          end
        end
      end
    end
  end
  removed
end

# Remove deliver's duplicate uploads (#230) from the editable App Store version, and VERIFY the result.
# deliver's presence-check races ASC's ~10-17s processing and re-uploads the whole set, leaving 2× of
# each. Because this dedup runs in that same window, a late-registering duplicate can be invisible on the
# first pass — so after each pass it re-checks per-locale counts against the committed set and, if they
# don't match, waits for ASC to settle and passes again, failing LOUD if it can't converge (never a
# silent green with duplicates left). Safe: only ever deletes same-named duplicates.
#
# The "same file name = duplicate" grouping is safe ONLY because each intended screenshot has a unique
# file name within its set (the framed set is NN_<device>_<screen>.png). Pagination isn't handled, but an
# ASC screenshot set caps at 10 and we ship 4/slot, so a set always fits one page.
def dedup_asc_screenshots
  configure_spaceship_token
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("No App Store Connect app record for #{APP_IDENTIFIER}.") if app.nil?

  expected = expected_screenshots_by_locale
  removed_total = 0

  DEDUP_MAX_ATTEMPTS.times do |attempt|
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version found — nothing to de-duplicate.") if version.nil?

    removed_total += dedup_pass(version)

    actual = asc_screenshots_by_locale(version)
    off = expected.reject { |locale, n| actual[locale] == n }
    if off.empty?
      UI.success("De-dup: removed #{removed_total} duplicate(s); every locale matches the committed set (#{expected.map { |l, n| "#{l}=#{n}" }.join(', ')}).")
      return removed_total
    end

    detail = off.map { |locale, n| "#{locale}: #{actual[locale]} on ASC vs #{n} expected" }.join("; ")
    if attempt < DEDUP_MAX_ATTEMPTS - 1
      UI.message("De-dup: not settled (#{detail}) — waiting #{DEDUP_SETTLE_SECONDS}s for ASC, then re-checking…")
      sleep(DEDUP_SETTLE_SECONDS)
    else
      UI.user_error!("De-dup did not converge after #{DEDUP_MAX_ATTEMPTS} attempts (#{detail}). Re-run `fastlane dedup_screenshots`.")
    end
  end
  removed_total
end

platform :ios do
  # --- build_only: archive + signed .ipa, no upload -------------------------
  desc "Archive + sign a Release .ipa (no upload). Bring-up step 2 isolator."
  lane :build_only do
    setup_ci # temporary keychain on CI; no-op locally

    match(
      type: "appstore",
      readonly: true,
      app_identifier: APP_IDENTIFIER,
      api_key: asc_api_key,
      # The certs repo's default branch is `main` (GitHub default); match otherwise defaults to
      # `master` and would check out an empty branch → "couldn't find a valid code signing identity".
      git_branch: "main"
    )

    # Force manual signing for the archive. match imported the cert + profile into the
    # temp keychain but left the project on Automatic; flip it to manual here so gym
    # signs with the match-managed Apple Distribution identity + profile (belt-and-braces
    # with the gym xcargs + export_options below).
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      profile_name: PROFILE_NAME,
      code_sign_identity: "Apple Distribution",
      team_id: TEAM_ID
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      # No ".ipa" here — gym appends the extension itself (a ".ipa" name would yield
      # PoimiApp.ipa.ipa). The beta lane reads the real path from lane_context.
      output_name: OUTPUT_NAME,
      # Predictable archive location so CI can upload its Info.plist as an artifact (AC).
      archive_path: File.join(OUTPUT_DIR, "#{OUTPUT_NAME}.xcarchive"),
      # Capture xcodebuild logs in the workspace so CI can upload them as artifacts.
      buildlog_path: File.join(OUTPUT_DIR, "logs"),
      # Inject the build number at archive time — VERSIONING_SYSTEM is unset and the
      # Info.plist is synthesized, so agvtool/increment_build_number cannot bump it.
      # Manual-signing settings are repeated here so the archive step itself uses them.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} " \
              "CODE_SIGN_STYLE=Manual " \
              "PROVISIONING_PROFILE_SPECIFIER='#{PROFILE_NAME}' " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => PROFILE_NAME }
      }
    )

    UI.success("Archived #{OUTPUT_NAME}.ipa — #{marketing_version} (#{build_number}).")
  end

  # --- beta: build_only + upload to TestFlight (internal) + processing poll --
  desc "Build, upload to TestFlight (internal), and fail unless the build reaches VALID."
  lane :beta do
    build_only

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      # Use the exact path gym reported (avoids any assumption about the .ipa filename).
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      distribute_external: false,          # internal testers only (no Beta App Review)
      skip_submission: true,               # do not submit for external review
      skip_waiting_for_build_processing: true # we poll explicitly below for a falsifiable VALID
    )

    processing_state = wait_for_valid_build(build_number)

    summarize(build_number, processing_state)
  end

  # --- upload_screenshots: push the framed App Store screenshots to ASC ------
  desc "Upload the framed App Store screenshots to App Store Connect — screenshots ONLY (no binary, no metadata, no submission). Run locally after Scripts/appstore-screenshots.sh + frame-all.mjs."
  lane :upload_screenshots do
    check_asc_env! # fail fast with a hint before upload_to_app_store hits a bare ENV.fetch

    path = framed_screenshots_path

    # Every framed image must be an exact ASC-accepted size — deliver silently skips any it can't map to
    # a device, so a compositor drift (e.g. 1320×2869) would ship a half-empty set under a green success.
    wrong = Dir.glob(File.join(path, "*", "*.png")).reject { |f| ACCEPTED_SCREENSHOT_SIZES.include?(png_dimensions(f)) }
    unless wrong.empty?
      listing = wrong.map { |f| "#{File.basename(File.dirname(f))}/#{File.basename(f)} = #{(png_dimensions(f) || %w[? ?]).join('×')}" }
      UI.user_error!("Framed screenshots not at an App-Store-accepted size (want 1320×2868 or 2064×2752) — " \
                     "deliver would silently drop these:\n  #{listing.join("\n  ")}")
    end

    # Screenshots only. deliver's `skip_metadata` still uploads screenshots (per its own docs, verified in
    # 2.237.0); we also skip the binary, the app-version fields, and review — so this touches nothing but
    # the screenshot slots of the current editable App Store version. ASC infers the device from image
    # dimensions (1320×2868 → iPhone 6.9", 2064×2752 → iPad 13"); the <locale> folders (en-US, fi) map to
    # ASC localizations (missing ones are auto-created); the NN_ filename prefix sets display order.
    # `overwrite_screenshots` clears ALL existing screenshot slots for en-US + fi before uploading (other
    # locales untouched) — so always upload a COMPLETE set. `force` skips the interactive HTML preview.
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      screenshots_path: path,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )

    # deliver's presence-check races ASC's processing and re-uploads the whole set, leaving 2× of each
    # (#230). Remove the duplicates so the listing ends with exactly the intended set — self-healing.
    dedup_asc_screenshots

    UI.success("Uploaded + de-duplicated screenshots from #{path} to App Store Connect (no binary, no metadata, no submission).")
  end

  # Clean up an already-duplicated listing WITHOUT re-uploading (deliver's verify-race leaves 2× of each,
  # #230). Idempotent + safe — deletes only same-named duplicates. See dedup_asc_screenshots.
  desc "Delete duplicate screenshots from the editable App Store version (deliver's verify-race leaves 2× of each, #230)."
  lane :dedup_screenshots do
    dedup_asc_screenshots
  end

  # --- upload_metadata: push the repo's App Store TEXT metadata to ASC (#236) --------
  desc "Upload the App Store text metadata (fastlane/metadata) to App Store Connect — TEXT ONLY (no binary, no screenshots, no submission). Repo is the source of truth."
  lane :upload_metadata do
    check_asc_env!

    # Pre-flight: every managed file must be NON-EMPTY (an empty file makes deliver PUT an empty value =
    # WIPES that ASC field, not a no-op) and within its char limit (deliver errors on over-limit; we fail
    # faster + friendlier). Only *.txt under a locale folder is metadata; a missing file stays unmanaged.
    files = Dir.glob(File.join(metadata_dir, "*", "*.txt")).sort
    UI.user_error!("No metadata files under #{metadata_dir} — nothing to upload.") if files.empty?
    problems = files.each_with_object([]) do |f, acc|
      rel = "#{File.basename(File.dirname(f))}/#{File.basename(f)}"
      text = File.read(f).strip
      acc << "#{rel} is EMPTY — that would wipe the ASC field" if text.empty?
      limit = METADATA_CHAR_LIMITS[File.basename(f, ".txt")]
      acc << "#{rel} is #{text.length} chars (max #{limit})" if limit && text.length > limit
    end
    UI.user_error!("Metadata pre-flight failed:\n  #{problems.join("\n  ")}") unless problems.empty?

    # Text only, and only the VERSION-LOCALIZATION fields (description/keywords/marketing_url/support_url).
    # No metadata_path: → deliver anchors fastlane/metadata to the Fastfile's folder (a relative path
    # would resolve under CWD = fastlane/). skip_app_version_update: localizations attach to the editable
    # version regardless; true avoids touching version-level fields. deliver only writes the fields it has
    # files for — so the App-Information group (name, subtitle, privacy URL) + promo text + pricing stay
    # ASC-owned (see fastlane/metadata/README.md). We deliberately keep App-Information OUT: deliver's
    # app-info write returns "No data" on a brand-new app's first version. Errors clearly if there's no
    # editable version, or if it has left "Prepare for Submission" (version-loc fields then reject).
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )

    UI.success("Uploaded #{files.size} metadata file(s) from #{metadata_dir} to App Store Connect (text only — no binary, no screenshots, no submission).")
  end

  # Poll App Store Connect for THIS run's build until it is VALID. Raises (fails the
  # run non-zero) on INVALID or on timeout — satisfying the falsifiable acceptance
  # criterion that "upload returned 0" is not sufficient.
  def wait_for_valid_build(expected_build)
    require "spaceship"
    require "base64"

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: Base64.decode64(ENV.fetch("ASC_KEY_CONTENT_BASE64"))
    )
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No App Store Connect app record for #{APP_IDENTIFIER}") if app.nil?

    deadline = Time.now + PROCESSING_TIMEOUT_SECONDS
    loop do
      # Filter by build number (CFBundleVersion), then also match the marketing version
      # (preReleaseVersion.version) so we identify THIS exact upload, not a same-numbered
      # build under a different marketing version.
      builds = app.get_builds(
        filter: { "version" => expected_build.to_s },
        includes: "preReleaseVersion"
      )
      build = builds.find { |b| b.pre_release_version&.version == marketing_version } || builds.first

      state = build&.processing_state
      UI.message("ASC build #{marketing_version} (#{expected_build}): #{state || 'not visible yet'}")

      case state
      when "VALID"
        return state
      when "INVALID", "FAILED"
        UI.user_error!("Build #{marketing_version} (#{expected_build}) finished processing as #{state}.")
      end

      if Time.now > deadline
        UI.user_error!("Timed out after #{PROCESSING_TIMEOUT_SECONDS}s waiting for build #{marketing_version} (#{expected_build}) to become VALID (last state: #{state || 'unseen'}).")
      end

      sleep(PROCESSING_POLL_SECONDS)
    end
  end

  # Echo the TestFlight identity (version + build) + ASC URL to the step summary (AC).
  def summarize(build, state)
    app_url = "https://appstoreconnect.apple.com/apps"
    identity = "#{marketing_version} (#{build})" # e.g. "0.1.0 (1234)"
    line = "TestFlight build **#{identity}** reached ASC processingState **#{state}**. " \
           "View in App Store Connect → TestFlight: #{app_url}"
    UI.success(line)

    summary_path = ENV["GITHUB_STEP_SUMMARY"]
    return if summary_path.nil? || summary_path.empty?

    File.open(summary_path, "a") do |f|
      f.puts("### TestFlight upload")
      f.puts("")
      f.puts("- TestFlight identity: `#{identity}`")
      f.puts("- Marketing version: `#{marketing_version}`")
      f.puts("- Build number: `#{build}`")
      f.puts("- ASC processingState: `#{state}`")
      f.puts("- App Store Connect (TestFlight): #{app_url}")
    end
  end
end
