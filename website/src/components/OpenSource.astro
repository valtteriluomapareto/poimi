---
import { GITHUB_URL } from '../consts';
---

<section id="open-source" class="section oss">
	<div class="oss-panel">
		<div class="oss-copy">
			<span class="eyebrow">Open source</span>
			<h2 class="oss-title">Open by design.</h2>
			<p class="lead">
				Poimi is open source under the AGPL-3.0 license &mdash; you can read
				exactly what it does.
			</p>
		</div>
		<div class="oss-actions">
			<a class="btn btn--dark" href={GITHUB_URL}>
				<svg viewBox="0 0 24 24" aria-hidden="true" class="gh"
					><path
						fill="#fff"
						d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.85 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.79.62-3.38-1.37-3.38-1.37-.46-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.23-.26-4.57-1.14-4.57-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.35 9.35 0 015 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.79-4.59 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0022 12.25C22 6.58 17.52 2 12 2z"
					></path></svg
				>
				View source on GitHub
			</a>
		</div>
	</div>
</section>

<style>
	.oss-panel {
		max-width: 1120px;
		margin-inline: auto;
		background: var(--color-bg-grouped);
		border-radius: var(--radius-xl);
		padding: clamp(30px, 4vw, 52px) clamp(26px, 4vw, 56px);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 48px;
	}
	.oss-copy {
		max-width: 560px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.oss-title {
		margin-top: 16px;
		font-size: clamp(28px, 3.4vw, 38px);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: -0.025em;
	}
	.oss-copy .lead {
		margin-top: 16px;
	}
	.oss-actions {
		display: flex;
		flex-direction: column;
		gap: 12px;
		flex-shrink: 0;
	}
	.oss-actions .btn {
		padding: 15px 26px;
		font-size: 16px;
	}
	.gh {
		width: 20px;
		height: 20px;
	}
	@media (max-width: 780px) {
		.oss-panel {
			flex-direction: column;
			align-items: stretch;
			gap: 28px;
		}
		.oss-actions .btn {
			justify-content: center;
		}
	}
</style>
