---
// NOTE: the badge below uses a stand-in Apple glyph for the pre-launch
// "Coming to the App Store" state. Before go-live (IS_APP_STORE_LIVE = true),
// swap the whole badge to Apple's official "Download on the App Store" artwork,
// per Apple's marketing/identity guidelines.
import { IS_APP_STORE_LIVE, APP_STORE_URL } from '../consts';

interface Props {
	/** 'badge' = full App Store badge; 'compact' = small nav pill. */
	variant?: 'badge' | 'compact';
}
const { variant = 'badge' }: Props = Astro.props;

const live = IS_APP_STORE_LIVE;
// When not live, render a non-link "coming soon" state (never a dead link).
const Tag = live ? 'a' : 'span';
const linkAttrs = live ? { href: APP_STORE_URL } : {};
---

{
	variant === 'compact' ? (
		<Tag class:list={['as-compact', { 'is-soon': !live }]} {...linkAttrs}>
			{live ? 'Download' : 'Coming soon'}
		</Tag>
	) : (
		<Tag class:list={['as-badge', { 'is-soon': !live }]} {...linkAttrs}>
			<svg class="as-apple" viewBox="0 0 384 512" aria-hidden="true">
				<path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
			</svg>
			{live ? (
				<span class="as-label">
					<span class="as-top">Download on the</span>
					<span class="as-store">App Store</span>
				</span>
			) : (
				<span class="as-label">
					<span class="as-top">Coming to the</span>
					<span class="as-store">App Store</span>
				</span>
			)}
		</Tag>
	)
}

<style>
	.as-badge {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		background: #000000;
		color: #ffffff;
		padding: 12px 22px;
		border-radius: 13px;
		transition: transform 0.15s ease;
	}
	a.as-badge:hover {
		transform: translateY(-1px);
	}
	.as-badge.is-soon {
		background: #3a3a3c;
		cursor: default;
	}
	.as-apple {
		width: 20px;
		height: 24px;
		margin-bottom: 2px;
		fill: #ffffff;
		flex-shrink: 0;
	}
	.as-label {
		display: flex;
		flex-direction: column;
		line-height: 1;
		text-align: left;
	}
	.as-top {
		font-size: 11px;
		font-weight: 400;
	}
	.as-store {
		font-size: 19px;
		font-weight: 600;
		margin-top: 2px;
	}
	.as-compact {
		display: inline-flex;
		align-items: center;
		background: var(--color-label);
		color: #ffffff;
		font-size: 14px;
		font-weight: 600;
		padding: 9px 17px;
		border-radius: var(--radius-full);
		transition: transform 0.15s ease;
	}
	a.as-compact:hover {
		transform: translateY(-1px);
	}
	.as-compact.is-soon {
		background: #3a3a3c;
		cursor: default;
	}
</style>
