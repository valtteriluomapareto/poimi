---
import { IS_APP_STORE_LIVE, APP_STORE_URL } from '../consts';

interface Props {
	/** 'badge' = full App Store badge; 'compact' = small nav pill. */
	variant?: 'badge' | 'compact';
}
const { variant = 'badge' }: Props = Astro.props;

const live = IS_APP_STORE_LIVE;
// When not live, render a non-link "coming soon" state (never a dead link).
const Tag = live ? 'a' : 'span';
const linkAttrs = live ? { href: APP_STORE_URL } : {};
---

{
	variant === 'compact' ? (
		<Tag class:list={['as-compact', { 'is-soon': !live }]} {...linkAttrs}>
			{live ? 'Download' : 'Coming soon'}
		</Tag>
	) : (
		<Tag class:list={['as-badge', { 'is-soon': !live }]} {...linkAttrs}>
			<svg class="as-apple" viewBox="0 0 14 17" aria-hidden="true">
				<path d="M9.6 2.6c.6-.75 1-1.78.87-2.6-.86.04-1.9.58-2.52 1.32-.56.66-1.05 1.71-.9 2.51.95.03 1.94-.5 2.55-1.23zM11.9 8.9c.02 2.3 2.02 3.06 2.05 3.07-.02.06-.32 1.1-1.06 2.18-.63.94-1.29 1.86-2.33 1.88-1.02.02-1.35-.6-2.52-.6-1.17 0-1.53.58-2.5.62-1 .04-1.76-1.01-2.4-1.94C-.2 14.2-1.2 10.66.13 8.28c.66-1.2 1.85-1.95 3.14-1.97.98-.02 1.9.66 2.5.66.6 0 1.72-.82 2.9-.7.49.02 1.88.2 2.77 1.5-.07.05-1.65.97-1.63 2.89z" />
			</svg>
			{live ? (
				<span class="as-label">
					<span class="as-top">Download on the</span>
					<span class="as-store">App Store</span>
				</span>
			) : (
				<span class="as-label">
					<span class="as-top">Coming to the</span>
					<span class="as-store">App Store</span>
				</span>
			)}
		</Tag>
	)
}

<style>
	.as-badge {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		background: #000000;
		color: #ffffff;
		padding: 12px 22px;
		border-radius: 13px;
		transition: transform 0.15s ease;
	}
	a.as-badge:hover {
		transform: translateY(-1px);
	}
	.as-badge.is-soon {
		background: #3a3a3c;
		cursor: default;
	}
	.as-apple {
		width: 22px;
		height: 26px;
		fill: #ffffff;
		flex-shrink: 0;
	}
	.as-label {
		display: flex;
		flex-direction: column;
		line-height: 1;
		text-align: left;
	}
	.as-top {
		font-size: 11px;
		font-weight: 400;
	}
	.as-store {
		font-size: 19px;
		font-weight: 600;
		margin-top: 2px;
	}
	.as-compact {
		display: inline-flex;
		align-items: center;
		background: var(--color-label);
		color: #ffffff;
		font-size: 14px;
		font-weight: 600;
		padding: 9px 17px;
		border-radius: var(--radius-full);
		transition: transform 0.15s ease;
	}
	a.as-compact:hover {
		transform: translateY(-1px);
	}
	.as-compact.is-soon {
		background: #3a3a3c;
		cursor: default;
	}
</style>
