---
interface Props {
	/** 'ink' = dark text (light bg); 'inverse' = white text (dark bg). */
	tone?: 'ink' | 'inverse';
	size?: number;
}
const { tone = 'ink', size = 30 }: Props = Astro.props;
const textColor = tone === 'inverse' ? '#ffffff' : 'var(--color-label)';
---

<span class="wordmark">
	<span class="mark" style={`width:${size}px;height:${size}px;`}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M5 12.5l4.2 4.2L19 7"
				stroke="var(--color-accent-on)"
				stroke-width="2.6"
				stroke-linecap="round"
				stroke-linejoin="round"
				fill="none"></path>
		</svg>
	</span>
	<span class="name" style={`color:${textColor};font-size:${size * 0.67}px;`}
		>Poimi</span
	>
</span>

<style>
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 11px;
	}
	.mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--color-accent);
		border-radius: 9px;
		flex-shrink: 0;
	}
	.mark svg {
		width: 58%;
		height: 58%;
	}
	.name {
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
	}
</style>
