---
import { withBase } from '../utils';

interface Props {
	/** 'ink' = dark text (light bg); 'inverse' = white text (dark bg). */
	tone?: 'ink' | 'inverse';
	size?: number;
}
const { tone = 'ink', size = 30 }: Props = Astro.props;
const textColor = tone === 'inverse' ? '#ffffff' : 'var(--color-label)';
// The app icon has an opaque ground, so pick the variant that blends into the
// wordmark's background: white on light, the dark variant on dark surfaces (the
// footer) — otherwise the white tile glares on dark.
const iconSrc = tone === 'inverse' ? 'icon-dark.png' : 'icon.png';
---

<span class="wordmark">
	<img
		class="mark"
		src={withBase(iconSrc)}
		alt=""
		aria-hidden="true"
		width={size}
		height={size}
		style={`width:${size}px;height:${size}px;`}
	/>
	<span class="name" style={`color:${textColor};font-size:${size * 0.67}px;`}
		>Poimi</span
	>
</span>

<style>
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 11px;
	}
	.mark {
		flex-shrink: 0;
		border-radius: 22%;
		object-fit: cover;
	}
	.name {
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
	}
</style>
