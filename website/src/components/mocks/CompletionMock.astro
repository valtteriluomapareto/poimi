---
const mosaic = ['#CBB69E', '#A7B4BC', '#9DA98F', '#D2C0AA'];
---

<div
	class="done-mock"
	role="img"
	aria-label="Poimi export complete — album added to Photos"
>
	<span class="dm-check">
		<svg viewBox="0 0 24 24" aria-hidden="true"
			><path
				d="M5 12.5l4.2 4.2L19 7"
				stroke="#fff"
				stroke-width="2.6"
				stroke-linecap="round"
				stroke-linejoin="round"
				fill="none"></path></svg
		>
	</span>
	<div class="dm-heading">
		<span class="dm-title">Added to Photos</span>
		<span class="dm-sub">Your 200 picks are now a native album.</span>
	</div>
	<div class="dm-album">
		<div class="dm-mosaic">
			{mosaic.map((c) => <span style={`background:${c}`} />)}
		</div>
		<div class="dm-meta">
			<span class="dm-name">Best of 2025</span>
			<span class="dm-count">200 photos</span>
		</div>
	</div>
	<span class="dm-open">Open in Photos</span>
</div>

<style>
	.done-mock {
		background: #fff;
		border: 1px solid var(--color-separator);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-card);
		padding: 36px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 16px;
	}
	.dm-check {
		width: 66px;
		height: 66px;
		border-radius: var(--radius-full);
		background: var(--color-secondary);
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.dm-check svg {
		width: 34px;
		height: 34px;
	}
	.dm-heading {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.dm-title {
		font-size: 23px;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
	}
	.dm-sub {
		font-size: 16px;
		color: var(--color-label-secondary);
	}
	.dm-album {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		margin-top: 6px;
	}
	.dm-mosaic {
		display: grid;
		grid-template-columns: repeat(2, 86px);
		grid-template-rows: repeat(2, 86px);
		border-radius: 18px;
		overflow: hidden;
	}
	.dm-meta {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.dm-name {
		font-size: 16px;
		font-weight: 600;
	}
	.dm-count {
		font-size: 13px;
		color: var(--color-label-secondary);
	}
	.dm-open {
		display: inline-flex;
		background: var(--color-label);
		color: #fff;
		font-size: 15px;
		font-weight: 600;
		padding: 12px 22px;
		border-radius: var(--radius-full);
		margin-top: 6px;
	}
</style>
