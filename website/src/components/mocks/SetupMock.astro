---
const fields = [
	{ label: 'Name', value: 'Best of 2025', accent: false },
	{ label: 'From', value: '1 Jan 2025', accent: false },
	{ label: 'To', value: '31 Dec 2025', accent: false },
	{ label: 'Target', value: '200 photos', accent: true },
];
const toggles = ['Screenshots', 'WhatsApp Media'];
---

<div
	class="setup-mock"
	role="img"
	aria-label="Poimi new-album setup — date range, target, and exclusions"
>
	<span class="sm-title">New album</span>
	<div class="sm-list">
		{
			fields.map((f) => (
				<div class="sm-row">
					<span class="sm-key">{f.label}</span>
					<span class:list={['sm-val', { accent: f.accent }]}>{f.value}</span>
				</div>
			))
		}
	</div>
	<span class="sm-kicker">Leave out</span>
	<div class="sm-list">
		{
			toggles.map((t) => (
				<div class="sm-row">
					<span class="sm-name">{t}</span>
					<span class="sm-toggle">
						<span class="sm-knob" />
					</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.setup-mock {
		background: #fff;
		border: 1px solid var(--color-separator);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-card);
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.sm-title {
		font-size: 18px;
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
	}
	.sm-list {
		border: 1px solid var(--color-separator);
		border-radius: var(--radius-md);
		overflow: hidden;
	}
	.sm-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 16px;
	}
	.sm-row + .sm-row,
	.sm-list .sm-row:not(:first-child) {
		border-top: 1px solid var(--color-separator);
	}
	.sm-key,
	.sm-name {
		font-size: 15px;
		color: var(--color-label-secondary);
	}
	.sm-name {
		color: var(--color-label);
	}
	.sm-val {
		font-size: 15px;
		font-weight: 600;
	}
	.sm-val.accent {
		color: var(--color-accent);
	}
	.sm-kicker {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-label-tertiary);
	}
	.sm-toggle {
		width: 42px;
		height: 25px;
		border-radius: var(--radius-full);
		background: var(--color-secondary);
		position: relative;
		flex-shrink: 0;
	}
	.sm-knob {
		position: absolute;
		top: 2.5px;
		right: 2.5px;
		width: 20px;
		height: 20px;
		border-radius: var(--radius-full);
		background: #fff;
	}
</style>
